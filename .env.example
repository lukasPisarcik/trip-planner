# Add your environment variables here.
# Each server var must also be declared in src/lib/server/env.server.ts so it
# gets validated at boot. Never read process.env / Bun.env directly elsewhere.
# `bunx convex dev` writes CONVEX_DEPLOYMENT + PUBLIC_CONVEX_URL into .env.local.

# --- Convex (data layer) ---
# Browser-facing deployment URL for reactive reads (client, via $env/static/public).
# Set automatically by `bunx convex dev`.
PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Server-side deployment URL (SSR reads + the AI agent + writes). Same value as
# PUBLIC_CONVEX_URL.
CONVEX_URL=https://your-deployment.convex.cloud

# Owner write-secret. Set the SAME value here AND on the Convex deployment with
# `bunx convex env set OWNER_WRITE_SECRET <value>`. The trusted (local) server
# sends it with every write. DO NOT set this on a public read-only deployment.
OWNER_WRITE_SECRET=replace-with-a-long-random-string

# Set to "true" on a public read-only deployment (e.g. Vercel) to block writes
# and hide the AI co-pilot. Leave unset for local development.
# VIEWER_MODE=true

# Shared site password. When set, every page redirects to /login and every API/
# remote-function request returns 401 until the password is entered (a signed
# httpOnly cookie). Leave unset locally; set it on the public deployment.
# Rotating the password signs everyone out.
# SITE_PASSWORD=replace-with-a-shared-password

# --- Google Maps (trip map backdrop) ---
# Browser-facing Maps JavaScript API key, read via $env/dynamic/public in the map
# component only (documented exception, like PUBLIC_CONVEX_URL). Create it in the
# Google Cloud console with "Maps JavaScript API" AND "Routes API" enabled (the
# map draws each day's driving route through the Maps JS Routes library; without
# Routes enabled, days fall back to dashed straight lines), referrer-restrict it
# to localhost:5173 + your deployment domain, and cap the daily quota. When unset,
# trips fall back to the solid hero banner (no map).
# PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-js-api-key

# Vector Map ID (required by Advanced Markers). Create one in the Google Cloud
# console (Map Management → Create Map ID, type JavaScript/vector). Falls back to
# DEMO_MAP_ID for local testing when unset.
# PUBLIC_GOOGLE_MAPS_MAP_ID=your-map-id

# --- AI co-pilot ---
# The co-pilot runs through a locally-installed CLI per provider; selecting a
# model in the picker dispatches to that provider. A provider's models show
# disabled until its CLI is signed in (Claude: `claude login`; OpenAI/Codex:
# `codex login`).

# Default Claude model when none is requested. Auth comes from `claude login`.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional override for the `claude` CLI binary path (only set if your
# install isn't on PATH).
# CLAUDE_CODE_PATH=/usr/local/bin/claude

# Default OpenAI/Codex model when none is requested. Auth comes from `codex login`
# (~/.codex/auth.json). Set to a model your installed Codex CLI accepts.
OPENAI_MODEL=gpt-5-codex

# Optional override for the `codex` CLI binary path (only set if your
# install isn't on PATH).
# CODEX_PATH=/usr/local/bin/codex

# Bearer token the Codex agent sends to this app's in-app trip-tools MCP endpoint
# (/api/mcp/trip-planner). The SDK and the route share it so only this server's
# own Codex subprocess can reach the tools. Optional (loopback-only otherwise).
# MCP_BRIDGE_SECRET=replace-with-a-long-random-string

# --- Expo bridge (temporary; removed in milestone 3 of the Expo port) ---
# The new Expo app calls this server's /api/ai/chat (SSE) and /api/bridge/reels/*
# over plain HTTP from another origin. All three are optional.
#
# Bearer the Expo app sends (`Authorization: Bearer ...`). Unset = bridge disabled:
# every bearer is rejected and /api/bridge/* always answers 401.
# Set SITE_PASSWORD whenever the bridge is reachable beyond localhost: with the
# site gate off, /api/ai/chat also answers requests that carry no bearer at all.
# BRIDGE_SECRET=replace-with-a-long-random-string
#
# Comma-separated CORS allow-list: the Expo web dev origin and its static host.
# Unset = no cross-origin browser may call the bridge routes.
# BRIDGE_ALLOWED_ORIGINS=http://localhost:8081,https://your-expo-web-host.example
#
# The owner's Clerk user id (the JWT subject, e.g. user_2abc...). When set it is sent
# as `userId` with every secret-gated Convex mutation, so rows this server writes are
# owned in the new user-scoped schema. Leave UNSET until the Expo repo's Convex
# functions are deployed — the legacy functions reject the extra argument.
# BRIDGE_OWNER_USER_ID=user_replace_me

# --- Reel transcription (the `transcribe_reel` tool) ---
# The co-pilot can transcribe the voiceover of a pasted TikTok/Instagram reel,
# locally and free: yt-dlp extracts the audio and whisper.cpp transcribes it.
# Set up once with: brew install yt-dlp ffmpeg whisper-cpp, then download a ggml
# model (e.g. ggml-large-v3-turbo.bin from the whisper.cpp HF repo).
#
# Absolute path to the ggml whisper model. When unset, transcription silently
# no-ops (the import falls back to caption + thumbnail). Note: a .env file does
# NOT expand `~`, so use the full path.
# WHISPER_MODEL_PATH=/Users/you/.whisper/ggml-large-v3-turbo.bin
#
# Optional binary path overrides (only set if they aren't on PATH).
# YT_DLP_PATH=/opt/homebrew/bin/yt-dlp
# WHISPER_CLI_PATH=/opt/homebrew/bin/whisper-cli
